{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // tsc is here to typecheck, not to build — vite does the transform. Without
    // this, `npm run build` left a compiled main.js and talopedia.js sitting in
    // src/ next to their sources.
    "noEmit": true
  },
  "include": ["src"]
}
